# Deployed AnnexMarket contract (Mezo Testnet)
VITE_ANNEX_ADDRESS=0x0000000000000000000000000000000000000000

# Settlement token — canonical MUSD on Mezo Testnet
VITE_MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503

# Optional: WalletConnect project id (enables the WalletConnect connector)
VITE_WALLETCONNECT_PROJECT_ID=

# Canonical Mezo Testnet CDP + Oracle defaults (override only if testing mocks)
# VITE_BORROWER_OPERATIONS_ADDRESS=0xCdF7028ceAB81fA0C6971208e83fa7872994beE5
# VITE_TROVE_MANAGER_ADDRESS=0xE47c80e8c23f6B4A1aE41c34837a0599D5D16bb0
# VITE_PRICE_FEED_ADDRESS=0x86bCF0841622a5dAC14A313a15f96A95421b9366
# VITE_HINT_HELPERS_ADDRESS=0x4e4cBA3779d56386ED43631b4dCD6d8EacEcBCF6
# VITE_SORTED_TROVES_ADDRESS=0x722E4D24FD6Ff8b0AC679450F3D91294607268fA

# Optional: point the app at a local node (e.g. anvil --chain-id 31611 --hardfork shanghai)
# VITE_RPC_URL=http://127.0.0.1:8545

# Optional: websocket URL. Leave empty — Annex polls over HTTP.
# Mezo's wss://rpc-ws.test.mezo.org rejects the HTTP upgrade (400, no
# `Connection: upgrade`), so it is deliberately not advertised by default.
# Set this only for a local anvil (anvil --port 8546).
# VITE_WSS_URL=ws://127.0.0.1:8546