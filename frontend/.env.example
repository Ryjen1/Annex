# Deployed AnnexMarket contract (Mezo Testnet)
VITE_ANNEX_ADDRESS=0x0000000000000000000000000000000000000000

# Settlement token — canonical MUSD on Mezo Testnet
VITE_MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503

# Optional: WalletConnect project id (enables the WalletConnect connector)
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: point the app at a local node (e.g. anvil --chain-id 31611)
# VITE_RPC_URL=http://127.0.0.1:8545

# Optional: websocket URL. Leave empty — Annex polls over HTTP.
# Mezo's wss://rpc-ws.test.mezo.org rejects the HTTP upgrade (400, no
# `Connection: upgrade`), so it is deliberately not advertised by default.
# Set this only for a local anvil (anvil --port 8546).
# VITE_WSS_URL=ws://127.0.0.1:8546